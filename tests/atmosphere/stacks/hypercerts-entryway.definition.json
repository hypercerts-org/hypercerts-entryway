{
  "version": 1,
  "id": "hypercerts-entryway",
  "services": [
    {
      "service": "configure",
      "environment": [
        {
          "name": "OAUTH_ISSUER_URL",
          "source": {
            "kind": "route-url",
            "route": "entryway"
          }
        },
        {
          "name": "OAUTH_CLIENT_URL",
          "source": {
            "kind": "route-url",
            "route": "client"
          }
        },
        {
          "name": "PDS1_URL",
          "source": {
            "kind": "route-url",
            "route": "cluster1"
          }
        },
        {
          "name": "PDS2_URL",
          "source": {
            "kind": "route-url",
            "route": "cluster2"
          }
        },
        {
          "name": "PLC_DIRECTORY_URL",
          "source": {
            "kind": "plc-url"
          }
        }
      ]
    },
    {
      "service": "entryway",
      "environment": []
    },
    {
      "service": "pds1",
      "environment": []
    },
    {
      "service": "pds2",
      "environment": []
    },
    {
      "service": "test",
      "environment": []
    },
    {
      "service": "browser",
      "environment": []
    },
    {
      "service": "entryway-postgres",
      "environment": []
    }
  ],
  "routes": [
    {
      "id": "entryway",
      "service": "entryway",
      "host": "entryway",
      "port": 3000
    },
    {
      "id": "handles",
      "service": "entryway",
      "host": "*.entryway",
      "port": 3000
    },
    {
      "id": "client",
      "service": "entryway",
      "port": 3000,
      "hostname": "client.entryway.example.com"
    },
    {
      "id": "cluster1",
      "service": "pds1",
      "host": "cluster1",
      "port": 3000
    },
    {
      "id": "cluster2",
      "service": "pds2",
      "host": "cluster2",
      "port": 3000
    }
  ],
  "secrets": []
}
