FROM mcr.microsoft.com/playwright:v1.58.2-noble
RUN apt-get update && apt-get install -y --no-install-recommends libnss3-tools && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build && mkdir -p artifacts
ENTRYPOINT ["sh", "/app/tests/support/browser-trust.sh"]
CMD ["npx", "--no-install", "playwright", "test", "--config", "tests/playwright.config.mjs"]
